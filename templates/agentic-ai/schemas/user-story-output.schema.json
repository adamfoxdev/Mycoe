{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UserStoryAgentOutput",
  "description": "Output schema for the User Story Agent",
  "type": "object",
  "required": ["workItemId", "classification", "status"],
  "properties": {
    "workItemId":           { "type": "integer" },
    "classification":       { "type": "string", "enum": ["READY", "NEEDS_AC", "NEEDS_SPLIT", "NEEDS_CLARIFICATION"] },
    "generatedAC":          { "type": "string", "description": "Generated acceptance criteria in Gherkin format" },
    "estimatedPoints":      { "type": ["integer", "null"], "enum": [1, 2, 3, 5, 8, 13, null] },
    "estimationReasoning":  { "type": "string" },
    "suggestedTasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "type", "estimatedHours"],
        "properties": {
          "title":          { "type": "string" },
          "type":           { "type": "string", "enum": ["DESIGN", "FRONTEND", "BACKEND", "TESTS", "REVIEW"] },
          "estimatedHours": { "type": "number", "minimum": 0.5 }
        }
      }
    },
    "technologyTags":       { "type": "array", "items": { "type": "string" } },
    "clarificationQuestions": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Questions to post if classification is NEEDS_CLARIFICATION"
    },
    "status":               { "type": "string", "enum": ["SUCCESS", "ESCALATED", "ERROR"] },
    "escalationReason":     { "type": "string", "default": "" }
  }
}
