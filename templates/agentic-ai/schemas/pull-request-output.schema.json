{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PullRequestAgentOutput",
  "description": "Output schema for the Pull Request Agent",
  "type": "object",
  "required": ["pullRequestNumber", "triageResult", "status"],
  "properties": {
    "pullRequestNumber": { "type": "integer" },
    "triageResult": {
      "type": "object",
      "properties": {
        "passed":         { "type": "boolean" },
        "failedGates":    { "type": "array", "items": { "type": "string" } }
      }
    },
    "acCoverage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["criterion", "coverage"],
        "properties": {
          "criterion": { "type": "string" },
          "coverage":  { "type": "string", "enum": ["covered", "partial", "not_covered"] },
          "notes":     { "type": "string", "default": "" }
        }
      }
    },
    "codeFindings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file", "line", "severity", "description", "recommendation"],
        "properties": {
          "file":           { "type": "string" },
          "line":           { "type": ["integer", "null"] },
          "severity":       { "type": "string", "enum": ["critical", "high", "medium", "low", "info"] },
          "category":       { "type": "string", "enum": ["security", "standards", "coverage", "documentation"] },
          "description":    { "type": "string" },
          "recommendation": { "type": "string" }
        }
      }
    },
    "coverageResult": {
      "type": "object",
      "properties": {
        "passed":     { "type": "boolean" },
        "statements": { "type": "number" },
        "branches":   { "type": "number" },
        "functions":  { "type": "number" }
      }
    },
    "recommendation":  { "type": "string", "enum": ["approve", "request_changes", "comment", "escalate"] },
    "reviewComment":   { "type": "string", "description": "The full formatted markdown comment to post on the PR" },
    "status":          { "type": "string", "enum": ["REVIEW_POSTED", "ESCALATED", "TRIAGE_FAILED", "ERROR"] },
    "escalationReason": { "type": "string", "default": "" }
  }
}
