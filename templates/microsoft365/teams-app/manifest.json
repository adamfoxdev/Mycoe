{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.17/MicrosoftTeams.schema.json",
  "manifestVersion": "1.17",
  "version": "1.0.0",
  "id": "00000000-0000-0000-0000-000000000000",
  "packageName": "com.mycoe.myteamsapp",
  "developer": {
    "name": "Mycoe Engineering",
    "websiteUrl": "https://mycoe.example.com",
    "privacyUrl": "https://mycoe.example.com/privacy",
    "termsOfUseUrl": "https://mycoe.example.com/terms"
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "name": {
    "short": "My App",
    "full": "My Teams App — replace with your app name"
  },
  "description": {
    "short": "Short description (≤80 characters)",
    "full": "Full description of your Teams app. What does it do and who is it for? (≤4000 characters)"
  },
  "accentColor": "#0078D4",
  "staticTabs": [
    {
      "entityId": "index",
      "name": "Home",
      "contentUrl": "https://localhost:3000/tab",
      "websiteUrl": "https://localhost:3000/tab",
      "scopes": ["personal"]
    }
  ],
  "configurableTabs": [],
  "bots": [],
  "connectors": [],
  "composeExtensions": [],
  "permissions": ["identity", "messageTeamMembers"],
  "validDomains": ["localhost"],
  "webApplicationInfo": {
    "id": "00000000-0000-0000-0000-000000000000",
    "resource": "api://localhost/00000000-0000-0000-0000-000000000000"
  }
}
